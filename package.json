{
  "name": "node-explorer",
  "version": "1.0.0",
  "description": "Basic explorer using react.js and electron.",
  "main": "main.js",
  "repository": "https://github.com/kaythecosmic/node-explorer.git",
  "author": "<kaynagpal03@gmail.com>",
  "license": "Apache",
  "private": false,
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "electron": "^29.1.0",
    "electronmon": "^2.0.2",
    "nodemon": "^3.1.0"
  },
  "scripts": {
    "postinstall": "install-app-deps",
    "start": "electron-forge start",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "appId": "bisexplorerV01",
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": "squirrel",
      "icon": "build/icon.ico"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "./icons/favicon",
        "productName": "Manak Mitra"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "ManakMitra"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "config": {
          "name": "Manak Mitra"
        },
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
          "name": "Manak Mitra"
        }
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {
          "name": "Manak Mitra"
        }
        }
      ]
    }
  },
  "dependencies": {
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "body-parser": "^1.20.2",
    "ejs": "^3.1.9",
    "electron-packager": "^17.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^4.18.3",
    "express-handlebars": "^7.1.2",
    "html": "^1.0.0",
    "jade": "^1.9.2",
    "multer": "^1.4.5-lts.1"
  }
}
